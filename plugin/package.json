{
  "name": "@residenthiago/dsh-web-tools",
  "version": "2.0.0",
  "description": "Free keyless web_search provider for DeepSeek Harness with DuckDuckGo and Bing fallback",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "duckduckgo",
    "bing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/residenthiago2011/DSH-Web-Tools.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/residenthiago2011/DSH-Web-Tools/tree/main/plugin#readme",
  "bugs": {
    "url": "https://github.com/residenthiago2011/DSH-Web-Tools/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
